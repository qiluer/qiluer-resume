{
  "name": "@qiluer-resume/dto",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsc --watch",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "development": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    },
    "./error": {
      "types": "./dist/modules/error/index.d.ts",
      "development": "./src/modules/error/index.ts",
      "default": "./dist/modules/error/index.js"
    },
    "./error/*": {
      "types": "./dist/modules/error/*.d.ts",
      "development": "./src/modules/error/*.ts",
      "default": "./dist/modules/error/*.js"
    },
    "./schemas/*": {
      "types": "./dist/modules/*/schemas.d.ts",
      "development": "./src/modules/*/schemas.ts",
      "default": "./dist/modules/*/schemas.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*/index.d.ts",
      "development": "./src/modules/*/index.ts",
      "default": "./dist/modules/*/index.js"
    }
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
