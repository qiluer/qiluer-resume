{
  "name": "qiluer-resume-server",
  "version": "0.0.1",
  "type": "module",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit --incremental false",
    "build": "pnpm run typecheck && nest build",
    "format": "pnpm exec prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src test vitest.config.ts vitest.config.e2e.ts rspack.config.js",
    "lint:fix": "oxlint --fix src test vitest.config.ts vitest.config.e2e.ts rspack.config.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.28",
    "@better-auth/redis-storage": "^1.6.28",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "^7.6.0",
    "@qiluer-resume/database": "workspace:*",
    "@qiluer-resume/dto": "workspace:*",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.6.28",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.16",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@rspack/core": "^2.2.5",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "oxlint": "^1.83.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11",
    "webpack-node-externals": "^3.0.0"
  }
}
